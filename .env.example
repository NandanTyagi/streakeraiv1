MONGO_DB_NAME=
NEXT_PUBLIC_USE_V3_ENGINE=true
NEXT_PUBLIC_ALLOWED_USERS=
OPENAI_API_KEY=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
